# Postgres database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=landing_optimizer

# Clickhouse database 
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DB=landing_optimizer
CLICKHOUSE_PASSWORD=

# API Auth
# JWT signing key, min 16 chars. Generate: openssl rand -base64 48
JWT_SECRET=dev-secret-change-me-32-bytes-min

# Shared bearer token between the API and AI service for internal requests. Generate: openssl rand -hex 32
AI_SERVICE_TOKEN=dev-internal-token

# Optional
# Generate: openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=